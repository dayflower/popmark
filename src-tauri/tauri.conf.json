{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Popmark",
  "version": "1.0.2",
  "identifier": "com.eula.dayflower.popmark",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Popmark",
        "width": 700,
        "height": 500,
        "decorations": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 28
        }
      },
      {
        "label": "settings",
        "title": "Popmark Settings",
        "url": "index.html#settings",
        "width": 540,
        "height": 640,
        "resizable": false,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright © 2026 dayflower",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
